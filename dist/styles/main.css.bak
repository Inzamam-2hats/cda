d{margin-bottom:15px}}.search-form .search__field:focus{border-color:#333;color:#333}.search-form .search__btn{position:relative;display:inline-block;height:50px;min-width:128px;max-width:150px;-ms-flex:0 0 150px;flex:0 0 150px;margin-left:15px;padding:0 41px;background:#fff;border-color:transparent;border:0;background:linear-gradient(270deg,#6bddd9 0,#5fcbd7);line-height:50px;color:#fff;border-radius:24px;font-family:Montserrat,sans-serif;font-weight:400;font-size:14px;line-height:48px;vertical-align:middle;text-align:center;cursor:pointer;text-decoration:none;-webkit-appearance:none;-moz-appearance:none;appearance:none;transition:.5s}@media (max-width:767px){.search-form .search__btn{max-width:100%;width:100%;margin:0}}.search-form .search__btn span{position:relative;z-index:4;display:block;transition:.5s}.search-form .search__btn:hover span{color:#4eccd9}.search-form .search__btn:hover:before{opacity:0;visibility:hidden}.search-form .search__btn:hover:after{opacity:1;visibility:visible}.tablepress caption{display:none!important}.tablepress tfoot th,.tablepress thead th{background:none}.tablepress thead th{border-bottom:2px solid #cdcdcd}.tablepress tbody td,.tablepress thead th{font-weight:700;font-size:14px}.tablepress tbody td:nth-child(odd),.tablepress thead th:nth-child(odd){background:#eee}
